---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/onest";
import { ViewTransitions } from "astro:transitions";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Pablo Monticoli — Full Stack Developer building AI-powered, scalable web applications."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="relative text-white">
    <div
      class="fixed inset-0 -z-10 h-full w-full"
      style="background:
        radial-gradient(ellipse 120% 60% at 85% 0%, rgba(124, 58, 237, 0.4) 0%, transparent 60%),
        radial-gradient(ellipse 80% 60% at 0% 60%, rgba(16, 185, 129, 0.1) 0%, transparent 55%),
        radial-gradient(ellipse 100% 50% at 100% 100%, rgba(67, 0, 180, 0.32) 0%, transparent 60%),
        #07070f;"
    >
    </div>

    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(255, 255, 255, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      ::selection {
        background: rgba(250, 204, 21, 0.3);
        color: #fff;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
