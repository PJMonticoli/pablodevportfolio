---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.webp";
import Badge from "./Badge.astro";
import SocialMedia from "./SocialMedia.astro";
import LinkedInIcon from "../icons/Linkedin.astro";
import MailIcon from "../icons/Mail.astro";
import GitHub from "../icons/GitHub.astro";
import FileText from "../icons/FileText.astro";
import { getDict, type Lang } from "../i18n";
import { CV_FILES, LINKS } from "../data/links";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).hero;
---

<div class="max-w-2xl">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3 mb-6" data-reveal>
    <Image
      class="rounded-full shadow-lg size-16 ring-2 ring-white/10 object-cover"
      src={avatar}
      alt={t.avatarAlt}
      width={64}
      height={64}
      densities={[1, 2, 3]}
      loading="eager"
    />
    <a
      href={LINKS.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="group rounded-full"
    >
      <Badge>{t.status}</Badge>
    </a>
  </div>
  <h1
    class="text-5xl font-bold tracking-tight text-white sm:text-6xl"
    data-reveal
  >
    {t.greeting}
  </h1>
  <p
    class="mt-6 text-xl leading-relaxed text-white/70 [&>strong]:text-yellow-300 [&>strong]:font-semibold"
    data-reveal
    set:html={t.lead}
  />
  <p class="mt-3 flex items-center gap-2 text-base text-white/60" data-reveal>
    {t.location}
    <img
      src="/flags/ar.svg"
      alt=""
      width="20"
      height="15"
      class="h-[0.85em] w-auto rounded-[2px]"
    />
  </p>

  <div class="flex flex-wrap gap-3 mt-8" data-reveal>
    <SocialMedia href={CV_FILES[lang]} label={t.cvLabel} primary>
      <FileText class="size-4" />
      {t.cv}
    </SocialMedia>
    <SocialMedia href={LINKS.github}>
      <GitHub class="size-4" aria-hidden="true" />
      GitHub
    </SocialMedia>
    <SocialMedia href={LINKS.linkedin}>
      <LinkedInIcon class="size-4" aria-hidden="true" />
      LinkedIn
    </SocialMedia>
    <SocialMedia href={LINKS.email} newTab={false}>
      <MailIcon class="size-4" aria-hidden="true" />
      {t.contact}
    </SocialMedia>
  </div>
</div>
