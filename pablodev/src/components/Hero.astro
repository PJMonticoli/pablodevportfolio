---
const personalImageAlt = "Pablo Monticoli";
import Badge from "../components/Badge.astro";
import LinkedInIcon from "../icons/Linkedin.astro";
import MailIcon from "../icons/Mail.astro";
import SocialMedia from "../components/SocialMedia.astro";
import GitHub from "../icons/GitHub.astro";
import Upload from "../icons/Upload.astro";
---

<div class="max-w-xl">
  <div class="flex items-center gap-4 mb-6" data-reveal>
    <img
      class="rounded-full shadow-lg size-16 ring-2 ring-white/10"
      src="/avatar.webp"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/pablo-javier-mont%C3%ADcoli-b69733248/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>
        <span data-i18n="openToWorkBadge">Working at Allata</span>
      </Badge>
    </a>
  </div>
  <h1
    class="text-5xl font-bold tracking-tight text-white sm:text-6xl"
    data-i18n="helloMessage"
    data-reveal
  >
    Hey, I'm Pablo
  </h1>
  <p
    class="mt-6 text-xl leading-relaxed text-white/70 [&>strong]:text-yellow-300 [&>strong]:font-semibold"
    data-reveal
  >
    <span data-i18n="experienceMessage">
      Full Stack Developer with 3+ years of experience in
    </span>
    <strong class="notranslate" data-i18n="roleDescription">
      AI-powered solutions.
    </strong>
    <span data-i18n="fromLocation">Based in Córdoba, Argentina.</span>
    <img
      src="/flags/ar.svg"
      alt="Argentina"
      width="20"
      height="15"
      class="inline-block h-[0.85em] w-auto rounded-[2px] align-baseline"
    />
    <span data-i18n="specializedMessage">
      I build scalable web applications and leverage AI to deliver real
      business impact.
    </span>
  </p>

  <nav class="flex flex-wrap gap-4 mt-8" data-reveal>
    <SocialMedia href="https://github.com/PJMonticoli">
      <GitHub class="size-4" />
      GitHub
    </SocialMedia>
    <SocialMedia
      href="https://www.linkedin.com/in/pablo-javier-mont%C3%ADcoli-b69733248/"
    >
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialMedia>
    <SocialMedia href="mailto:pablo_monticoli@hotmail.com">
      <MailIcon class="size-4" />
      <span data-i18n="mailText">Contact me</span>
    </SocialMedia>
    <SocialMedia
      href="/MonticoliPabloResume.pdf"
      download="MonticoliPabloResume.pdf"
    >
      <Upload class="size-4" />
      Cv
    </SocialMedia>
  </nav>
</div>
