---
const navItems = [
  { key: "navExperience", url: "/#experience" },
  { key: "navProject", url: "/#projects" },
  { key: "navContact", url: "mailto:pablo_monticoli@hotmail.com" },
];
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-3">
  <nav
    id="main-nav"
    class="flex px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium tracking-tight rounded-full text-white/70 justify-center items-center transition-all duration-300 ease-out"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 sm:px-3 py-2 whitespace-nowrap transition-colors hover:text-yellow-400"
          aria-label={link.key}
          href={link.url}
        >
          {link.key}
        </a>
      ))
    }
    <span class="w-px h-4 bg-white/15 mx-0.5 sm:mx-1" aria-hidden="true"></span>
    <div class="checkbox-wrapper-35 flex items-center px-0.5 sm:px-1 scale-90 sm:scale-100">
      <input type="checkbox" id="languageSwitch" class="switch" />
      <label for="languageSwitch">
        <span class="switch-x-text"></span>
        <span class="switch-x-toggletext">
          <span class="switch-x-unchecked">🇬🇧</span>
          <span class="switch-x-checked">🇪🇸</span>
        </span>
      </label>
    </div>
  </nav>
</header>

<script>
  interface Translations {
    [key: string]: string;
  }

  const translations: { [key: string]: Promise<Translations> } = {
    en: fetch("/locales/en/translation.json").then((r) => r.json()),
    es: fetch("/locales/es/translation.json").then((r) => r.json()),
  };

  function loadLanguage(lang: string) {
    translations[lang].then((trans: Translations) => {
      document.querySelectorAll("[aria-label]").forEach((el) => {
        const key = (el as HTMLElement).getAttribute("aria-label");
        if (key && trans[key]) {
          (el as HTMLElement).textContent = trans[key];
        }
      });
    });
  }

  function handleLanguageChange(event: Event) {
    const target = event.target as HTMLInputElement;
    const lang = target.checked ? "es" : "en";
    localStorage.setItem("language", lang);
    loadLanguage(lang);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const savedLang = localStorage.getItem("language") || "en";
    const switchEl = document.getElementById("languageSwitch") as HTMLInputElement;
    if (switchEl) {
      switchEl.checked = savedLang === "es";
      loadLanguage(savedLang);
    }
    switchEl?.addEventListener("change", handleLanguageChange);

    const nav = document.getElementById("main-nav");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        nav?.classList.add(
          "shadow-lg",
          "shadow-black/20",
          "backdrop-blur-md",
          "bg-white/[0.06]",
          "ring-1",
          "ring-white/10",
          "px-4"
        );
      } else {
        nav?.classList.remove(
          "shadow-lg",
          "shadow-black/20",
          "backdrop-blur-md",
          "bg-white/[0.06]",
          "ring-1",
          "ring-white/10",
          "px-4"
        );
      }
    }, { passive: true });
  });
</script>

<style>
  /* Language switch  */
  .checkbox-wrapper-35 .switch { display: none; }

  .checkbox-wrapper-35 .switch + label {
    align-items: center;
    color: #fff;
    cursor: pointer;
    display: flex;
    font-size: 12px;
    line-height: 15px;
    position: relative;
    user-select: none;
  }

  .checkbox-wrapper-35 .switch + label::before,
  .checkbox-wrapper-35 .switch + label::after {
    content: "";
    display: block;
  }

  .checkbox-wrapper-35 .switch + label::before {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 500px;
    height: 15px;
    margin-right: 8px;
    transition: background-color 0.125s ease-out;
    width: 25px;
  }

  .checkbox-wrapper-35 .switch + label::after {
    background-color: #fff;
    border-radius: 13px;
    height: 13px;
    left: 1px;
    position: absolute;
    top: 1px;
    transition: transform 0.125s ease-out;
    width: 13px;
  }

  .checkbox-wrapper-35 .switch + label .switch-x-text {
    display: block;
    margin-right: 0.3em;
  }

  .checkbox-wrapper-35 .switch + label .switch-x-toggletext {
    display: block;
    font-weight: bold;
    height: 15px;
    overflow: hidden;
    position: relative;
    width: 25px;
  }

  .checkbox-wrapper-35 .switch + label .switch-x-unchecked,
  .checkbox-wrapper-35 .switch + label .switch-x-checked {
    left: 0;
    position: absolute;
    top: 0;
    transition: opacity 0.125s ease-out, transform 0.125s ease-out;
  }

  .checkbox-wrapper-35 .switch + label .switch-x-unchecked {
    opacity: 1;
    transform: none;
  }

  .checkbox-wrapper-35 .switch + label .switch-x-checked {
    opacity: 0;
    transform: translate3d(0, 100%, 0);
  }

  .checkbox-wrapper-35 .switch:checked + label::before {
    background-color: #ffb500;
  }

  .checkbox-wrapper-35 .switch:checked + label::after {
    transform: translate3d(10px, 0, 0);
  }

  .checkbox-wrapper-35 .switch:checked + label .switch-x-unchecked {
    opacity: 0;
    transform: translate3d(0, -100%, 0);
  }

  .checkbox-wrapper-35 .switch:checked + label .switch-x-checked {
    opacity: 1;
    transform: none;
  }
</style>
