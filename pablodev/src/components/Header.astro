---
import MenuIcon from "../icons/Menu.astro";
import { getDict, homePath, LANGS, LANG_NAMES, type Lang } from "../i18n";
import { LINKS } from "../data/links";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const base = homePath(lang);

const sections = [
  { id: "workflow", label: t.nav.workflow },
  { id: "experience", label: t.nav.experience },
  { id: "projects", label: t.nav.projects },
  { id: "stack", label: t.nav.stack },
  { id: "certifications", label: t.nav.certifications },
];
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-3 px-2">
  <nav
    id="main-nav"
    aria-label={t.nav.label}
    class="relative flex max-w-full px-2 md:px-3 py-1 text-sm font-medium tracking-tight rounded-full text-white/70 justify-center items-center transition-all duration-300 ease-out"
  >
    <div class="hidden md:flex items-center">
      {
        sections.map((section) => (
          <a
            class="block px-3 py-2 whitespace-nowrap transition-colors hover:text-yellow-400"
            href={`${base}#${section.id}`}
            data-nav={section.id}
          >
            {section.label}
          </a>
        ))
      }
      <a
        class="block px-3 py-2 whitespace-nowrap transition-colors hover:text-yellow-400"
        href={LINKS.email}
      >
        {t.nav.contact}
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="md:hidden inline-flex items-center gap-2 rounded-full px-3 py-2 text-white/80 transition-colors hover:text-yellow-400"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <MenuIcon class="size-5" />
      {t.nav.menu}
    </button>

    <span class="w-px h-4 bg-white/15 mx-1" aria-hidden="true"></span>
    <div
      class="flex items-center gap-0.5 rounded-full bg-white/[0.06] p-0.5 text-xs font-semibold"
      role="group"
      aria-label={t.nav.language}
    >
      {
        LANGS.map((l) => (
          <a
            href={homePath(l)}
            hreflang={l}
            lang={l}
            aria-label={LANG_NAMES[l]}
            aria-current={l === lang ? "true" : undefined}
            class:list={[
              "rounded-full px-2.5 py-1.5 transition-colors duration-200",
              l === lang
                ? "bg-yellow-400 text-black"
                : "text-white/70 hover:text-white",
            ]}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>

    <div
      id="nav-menu"
      hidden
      class="md:hidden absolute left-1/2 top-full mt-2 w-60 -translate-x-1/2"
    >
      <ul
        class="flex flex-col rounded-2xl bg-[#0c0c17] p-2 text-base shadow-xl shadow-black/40 ring-1 ring-white/10"
      >
        {
          sections.map((section) => (
            <li>
              <a
                class="block rounded-xl px-4 py-3 transition-colors hover:bg-white/5 hover:text-yellow-400"
                href={`${base}#${section.id}`}
                data-nav={section.id}
              >
                {section.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="block rounded-xl px-4 py-3 transition-colors hover:bg-white/5 hover:text-yellow-400"
            href={LINKS.email}
          >
            {t.nav.contact}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const SCROLLED_CLASSES = [
    "shadow-lg",
    "shadow-black/20",
    "backdrop-blur-md",
    "bg-white/[0.06]",
    "ring-1",
    "ring-white/10",
  ];

  document.addEventListener("DOMContentLoaded", () => {
    const nav = document.getElementById("main-nav");
    const sentinel = document.getElementById("scroll-sentinel");
    if (nav && sentinel) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          SCROLLED_CLASSES.forEach((cls) =>
            nav.classList.toggle(cls, !entry.isIntersecting),
          );
        },
        { rootMargin: "-50px 0px 0px 0px" },
      );
      observer.observe(sentinel);
    }

    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener("click", () => setOpen(menu.hidden));
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!menu.hidden && !(event.target as HTMLElement).closest("#main-nav")) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>
