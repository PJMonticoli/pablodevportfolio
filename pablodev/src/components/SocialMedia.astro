---
interface Props {
  href: string;
  primary?: boolean;
  newTab?: boolean;
  label?: string;
}

const { href, primary = false, newTab = true, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full border transition-[background-color,border-color,color,transform] duration-200 ease-out hover:-translate-y-0.5 max-w-fit active:translate-y-0 active:scale-[0.97] motion-reduce:transform-none",
    primary
      ? "bg-yellow-400 border-yellow-400 text-black font-semibold hover:bg-yellow-300 hover:border-yellow-300"
      : "bg-white/5 border-white/10 text-white/80 hover:bg-white/10 hover:border-white/20 hover:text-white",
  ]}
>
  <slot />
</a>
