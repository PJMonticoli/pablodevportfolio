---
const currentYear = new Date().getFullYear();
import GitHub from "../icons/GitHub.astro";
import Linkedin from "../icons/Linkedin.astro";
import Mail from "../icons/Mail.astro";
---

<footer
  class="mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 px-4"
>
  <div
    class="flex flex-col items-center gap-6 border-t border-white/10 pt-8 md:flex-row md:justify-between"
    data-reveal
  >
    <span class="text-sm text-white/50"
      >© {currentYear}
      <span data-i18n="footerMessage">
        Web-Site Developed by Pablo Monticoli
      </span>
    </span>
    <nav class="flex items-center gap-4">
      <a
        href="https://github.com/PJMonticoli"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-white/50 transition-colors duration-200 hover:text-yellow-400"
      >
        <GitHub class="size-5" />
      </a>
      <a
        href="https://www.linkedin.com/in/pablo-javier-mont%C3%ADcoli-b69733248/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-white/50 transition-colors duration-200 hover:text-yellow-400"
      >
        <Linkedin class="size-5" />
      </a>
      <a
        href="mailto:pablo_monticoli@hotmail.com"
        aria-label="Email"
        class="text-white/50 transition-colors duration-200 hover:text-yellow-400"
      >
        <Mail class="size-5" />
      </a>
    </nav>
  </div>
</footer>
