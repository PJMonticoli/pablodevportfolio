---
import GitHub from "../icons/GitHub.astro";
import Linkedin from "../icons/Linkedin.astro";
import Mail from "../icons/Mail.astro";
import { getDict, type Lang } from "../i18n";
import { LINKS } from "../data/links";

interface Props {
  lang: Lang;
}

const t = getDict(Astro.props.lang).footer;
const currentYear = new Date().getFullYear();
const linkClass =
  "text-white/60 transition-colors duration-200 hover:text-yellow-400";
---

<footer
  class="mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 px-4"
>
  <div
    class="flex flex-col items-center gap-6 border-t border-white/10 pt-8 md:flex-row md:justify-between"
    data-reveal
  >
    <span class="text-sm text-white/60">© {currentYear} {t.message}</span>
    <nav class="flex items-center gap-4" aria-label={t.navLabel}>
      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class={linkClass}
      >
        <GitHub class="size-5" aria-hidden="true" />
      </a>
      <a
        href={LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class={linkClass}
      >
        <Linkedin class="size-5" aria-hidden="true" />
      </a>
      <a href={LINKS.email} aria-label={t.email} class={linkClass}>
        <Mail class="size-5" aria-hidden="true" />
      </a>
    </nav>
  </div>
</footer>
