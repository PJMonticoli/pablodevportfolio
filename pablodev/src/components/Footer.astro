---
const currentYear = new Date().getFullYear();
---

<footer
  class="m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center border-t border-white/10 pt-8"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-center py-4"
  >
    <span class="text-sm sm:text-center text-white/50"
      >© {currentYear}
      <span data-i18n="footerMessage">
        Web-Site Developed by Pablo Monticoli
      </span>
    </span>
  </div>
</footer>
