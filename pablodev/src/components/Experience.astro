---
import ExperienceItem from "./ExperienceItem.astro";
import { getDict, type Lang } from "../i18n";
import { COMPANY_SITES } from "../data/links";

interface Props {
  lang: Lang;
}

const t = getDict(Astro.props.lang).experience;
---

<ol class="relative mt-12">
  {
    t.items.map((item) => (
      <li data-reveal>
        <ExperienceItem
          {...item}
          link={COMPANY_SITES[item.id]}
          linkLabel={t.site}
        />
      </li>
    ))
  }
</ol>
