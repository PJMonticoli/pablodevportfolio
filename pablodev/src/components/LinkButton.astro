---
const { href } = Astro.props;
---

<a
  href={href}
  role="link"
  target="_blank"
  class="inline-flex items-center justify-center gap-2 px-3 py-2 text-base text-white/80 transition-all duration-200 bg-white/5 border border-white/10 text-md hover:bg-white/10 hover:border-white/20 hover:text-white hover:-translate-y-0.5 group max-w-fit rounded-xl focus:outline-none focus-visible:ring focus-visible:ring-yellow-400/60 focus-visible:ring-offset-2 focus-visible:ring-offset-black active:translate-y-0"
>
  <slot />
</a>
