---
interface Props {
  href: string;
  label?: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center justify-center gap-2 px-3 py-2 text-base text-white/80 transition-[background-color,border-color,color,transform] duration-200 ease-out bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 hover:text-white hover:-translate-y-0.5 max-w-fit rounded-full active:translate-y-0 active:scale-[0.97] motion-reduce:transform-none"
>
  <slot />
</a>
